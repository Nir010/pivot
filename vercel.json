{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "pivot-risk-website/pivot-risk",
  "rewrites": [
    { "source": "/", "destination": "/html/index.html" },
    { "source": "/index", "destination": "/html/index.html" },
    { "source": "/about", "destination": "/html/about.html" },
    { "source": "/services", "destination": "/html/services.html" },
    { "source": "/team", "destination": "/html/team.html" },
    { "source": "/contact", "destination": "/html/contact.html" }
  ]
}
